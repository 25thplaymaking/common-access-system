# Copy this file to .env and fill it in. Never commit .env or share your token.

# Bot token from the Discord Developer Portal (Bot tab -> Reset Token).
DISCORD_BOT_TOKEN=

# Your server's ID (turn on Developer Mode in Discord, right-click the server
# icon -> Copy Server ID). The bot only works in this one server.
DISCORD_GUILD_ID=

# Time zone that event times are typed in (IANA name). Members still see
# every event in their own local time.
TIMEZONE=UTC

# Optional branding.
BOT_NAME=Common Access System
ACCENT_COLOR=#3b82f6
BRAND_ICON_URL=

# Minutes before an event that signed-up members get a reminder.
REMINDER_MINUTES=30

# Where the database file lives. Docker sets this for you.
DATA_DIR=./data
